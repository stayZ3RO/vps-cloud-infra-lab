# Umami stack environment - VPS Cloud Infrastructure Lab
# Phase: Phase 4 - Docker App Deployment
#
# Copy to .env on the VPS and fill in real values:
#   cp .env.example .env
#
# .env is gitignored and never leaves the VPS.
#
# Generate APP_SECRET:
#   openssl rand -base64 32
#
# POSTGRES_PASSWORD: use a long random value. It is embedded in DATABASE_URL
# inside docker-compose.yml, so avoid URL-special characters (! # % & etc.)
# or percent-encode them, or the connection string will parse incorrectly.

POSTGRES_PASSWORD=change-me-long-random
APP_SECRET=change-me-openssl-rand-base64-32
